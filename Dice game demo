'''题目4 随机数据生成
生成一个（3，4）的随机整数数组，范围【0，10）
-计算每列的最大值和每行的最小值
-将数组中的所有奇数替换为-1
'''
# 三行四列数组生成
# 设置种子将值固定
print()
print('问题4：')
np.random.seed(0)
arr = np.random.randint(0,10,(3,4))
print('随机数组为：\n', arr)
# np.max取最大值，设置参数axis=0代表列 axis=0代表行
print('每列的最大值：\n', np.max(arr,axis=0))
print('每行的最小值：\n', np.min(arr,axis=1))
# where三个参数为条件，符合条件的改为_,不符合条件的改为_
print('改奇数元素：\n', np.where(arr%2==1,-1,arr))
# 布尔索引,直接在原数组操作，改变原数组
arr[arr%2==1]=-1
print('改奇数元素1：\n', arr)
# 拓展索引操作
# 改变行元素
arr[0] = 1
print('改变行元素:\n', arr)
# 改变列元素
arr[:,0] = 1
print('改变列元素：\n', arr)

'''题目5 数组变形
创建一个1到12的一维数组，并转换为（3，4）的二维数组
-计算每行的和与每列的平均值
-将数组展平为一维数组'''
print()
print('问题5：')
# 创建数组
arr = np.random.randint(1,12,12)
print('数组为：', arr)
# 转换为二维数组
arr = np.reshape(arr,(3,4))
print('转为二维数组为：\n', arr)
# 每行的和
print('每行的和：', np.sum(arr,axis=1))
# 每列的平均值
print('每列的平均值：', np.mean(arr,axis=0))
#展平为一维数组
print('展平为一维数组：', np.reshape(arr,(12)))

'''题目6 不二索引
生成一个（5，5）的随机数组，范围【0，20）
-找出数组中大于10的元素
-将所有大于10的元素替换为0'''
print()
