'''问题7 统计函数应用
某公司6个月的销售额（万元）为【120，135，110，125，130，140】
-计算销售额的总和，均值和方差
-找出销售额最高的月份和最低的月份
'''
# 设置数组列表
print()
print('问题7：')
arr = np.array([120,135,110,125,130,140])
# 销售额总和
print('销售额总和：', np.sum(arr),'万元')
print('销售额均值：%.2f'% np.average(arr), '万元') #或用np.mean
print('销售额方差：%.2f'% np.var(arr),'万元')
# 最高月份最低月份
print('最高的月份：', np.argmax(arr)+1, '月')
print('最低的月份', np.argmin(arr)+1,'月')

