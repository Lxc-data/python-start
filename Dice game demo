'''此部分为简短代码演示python的精简与实用性，也更直观让各位初学者感受到python最简单易学'''
import numpy as np

'''题目1 温度数据分析
某城市一周的最高气温（℃）为【28，30，29，31，32，30，29】
-计算平均气温，最高气温和最低气温
-找出气温超过30℃的天数
'''
# 先将数据存储为列表
print('问题1：')
tem = np.array([28,30,29,31,32,30,29])
# 求平均温度
avg = np.average(tem)
# 输出平均温度保留两位小数
print('平均气温为：%.2f' % avg, '℃')
# for循环查询气温超过30℃的天数
count = 0
for temp in tem:
    if temp > 30:
        count += 1
print(f'气温超过30℃的天数：{count}天')
# 简化
counts = np.sum(tem > 30)
print('气温超过30℃的天数0：',counts, '天')
# 或直接print函数
print('气温超过30℃的天数01：',np.sum(tem > 30), '天')
# 或者直接np函数
# 先用np.where把布尔值转为0/1,用cumsum计算累积和,取最后一个值得到总数，
# 太过复杂为人类思维，重理解逻辑
print('气温超过30℃的天数1：', np.cumsum(np.where(tem > 30,1,0))[-1], '天')
# 直接len函数判断有多少个符合条件元素
print('气温超过30℃的天数2：', len(tem[tem > 30]), '天')

'''题目2 学生成绩统计
某班级5名学生的数学成绩为【85，90，78，92，88】
-计算成绩平均分，中位数和标准差
-将成绩转换为十分制'''
print()
print('问题2：')
# 定义成绩列表
grad = np.array([85,90,78,92,88])
# np.average函数求平均分
print('平均分：', np.average(grad), '分')
# 中位数
print('中位数：', np.median(grad), '分')
